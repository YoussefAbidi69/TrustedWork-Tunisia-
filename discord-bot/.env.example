# Bot token — Developer Portal → Bot → Token (NOT Application ID)
DISCORD_TOKEN=

# Application ID — Developer Portal → General Information
DISCORD_CLIENT_ID=

# Optional: embed left stripe color (hex without # or with #)
DISCORD_EMBED_COLOR=#6366f1

# Optional: guild id for faster slash command registration while testing
DISCORD_GUILD_ID=

# Backend ms-community URL (Spring Boot service)
MS_COMMUNITY_URL=http://localhost:8084

# Frontend app URL (for embed "Read Post" / "View Course" links)
APP_BASE_URL=http://localhost:4200

# Default user ID for API calls (linked app user)
DEFAULT_USER_ID=1

# Feed sync interval in milliseconds (default: 5 minutes = 300000)
FEED_POLL_INTERVAL_MS=300000

# Timezone for digest scheduling (default: Europe/Paris)
DIGEST_TIMEZONE=Europe/Paris

# AI Provider API Key (e.g., OpenAI)
OPENAI_API_KEY=

# Internal Webhook Server Port (for receiving backend events)
WEBHOOK_PORT=3000

# Secret token to authenticate incoming webhooks from ms-community
WEBHOOK_SECRET=your_super_secret_webhook_token
